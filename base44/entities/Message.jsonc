{
  "name": "Message",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "title": "Booking ID"
    },
    "sender_email": {
      "type": "string",
      "title": "Sender Email"
    },
    "sender_name": {
      "type": "string",
      "title": "Sender Name"
    },
    "recipient_email": {
      "type": "string",
      "title": "Recipient Email"
    },
    "content": {
      "type": "string",
      "title": "Message Content"
    }
  },
  "required": [
    "booking_id",
    "sender_email",
    "content"
  ],
  "rls": {
    "create": {
      "data.sender_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}