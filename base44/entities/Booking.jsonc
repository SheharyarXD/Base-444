{
  "name": "Booking",
  "type": "object",
  "properties": {
    "contractor_id": {
      "type": "string",
      "title": "Contractor ID"
    },
    "contractor_name": {
      "type": "string",
      "title": "Contractor Name"
    },
    "contractor_category": {
      "type": "string",
      "title": "Category"
    },
    "category": {
      "type": "string",
      "title": "Service Category",
      "enum": [
        "Plumbing",
        "Electrical",
        "Cleaning",
        "Painting",
        "Landscaping",
        "HVAC",
        "Carpentry",
        "Roofing",
        "General Handyman",
        "Moving",
        "Mobile Mechanic",
        "Mobile Detailer",
        "Lawn Care",
        "Other",
        "Contractors",
        "Pressure Washing Services",
        "Fencing Services",
        "Heavy Wheel Mechanic",
        "Garage Door Specialists",
        "Tree Services",
        "Appliance Repair",
        "Small Engine Repair",
        "Towing Service",
        "Concrete Services"
      ]
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "customer_phone": {
      "type": "string",
      "title": "Customer Phone"
    },
    "customer_type": {
      "type": "string",
      "title": "Customer Type",
      "enum": [
        "Realtor",
        "Homeowner"
      ]
    },
    "job_title": {
      "type": "string",
      "title": "Job Title"
    },
    "job_description": {
      "type": "string",
      "title": "Job Description"
    },
    "address": {
      "type": "string",
      "title": "Job Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip": {
      "type": "string",
      "title": "Zip Code"
    },
    "preferred_date": {
      "type": "string",
      "title": "Preferred Date",
      "format": "date"
    },
    "preferred_time": {
      "type": "string",
      "title": "Preferred Time",
      "enum": [
        "Morning (8am-12pm)",
        "Afternoon (12pm-4pm)",
        "Evening (4pm-8pm)",
        "Flexible"
      ]
    },
    "estimated_hours": {
      "type": "number",
      "title": "Estimated Hours"
    },
    "estimated_cost": {
      "type": "number",
      "title": "Estimated Cost ($)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "accepted",
        "on_the_way",
        "arriving",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string",
      "title": "Additional Notes"
    },
    "contractor_lat": {
      "type": "number",
      "title": "Contractor Latitude"
    },
    "contractor_lng": {
      "type": "number",
      "title": "Contractor Longitude"
    },
    "contractor_location_updated_at": {
      "type": "string",
      "title": "Provider Location Updated At",
      "format": "date-time",
      "description": "Server-stamped time of the last accepted provider location write (set by the updateProviderLocation function, never by a client). Without this a customer cannot tell a live position from a half-hour-old one, so the tracking UI treats a missing/old value as not-live rather than as current — see classifyLocationFreshness in src/lib/tracking.js. Cleared, along with the coordinates, when the booking reaches completed/cancelled."
    },
    "contractor_location_accuracy_m": {
      "type": "number",
      "title": "Provider Location Accuracy (metres)",
      "description": "Reported GPS accuracy radius of the last accepted fix. Fixes worse than MAX_ACCEPTABLE_ACCURACY_METERS are rejected rather than stored, so a customer is never shown a city-block-wide guess as a precise position."
    },
    "job_lat": {
      "type": "number",
      "title": "Job Location Latitude"
    },
    "job_lng": {
      "type": "number",
      "title": "Job Location Longitude"
    },
    "is_priority": {
      "type": "boolean",
      "title": "Priority Booking",
      "default": false
    },
    "accepted_by_email": {
      "type": "string",
      "title": "Accepted By (Contractor Email)"
    },
    "accepted_by_name": {
      "type": "string",
      "title": "Accepted By (Contractor Name)"
    },
    "photo_urls": {
      "type": "array",
      "title": "Job Photos",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "job_title",
    "address",
    "preferred_date",
    "category"
  ],
  "rls": {
    "_comment_read_policy": "The read policy previously carried a clause granting every signed-in user access to any booking while its status was 'pending'. That clause made open-job discovery work, but this platform's policies apply to whole rows, so it also exposed the customer's phone number, email address and exact street address on every open job to anyone with an account. It has been removed. Discovery now goes through the getOpenJobs function, which reads under the service role and returns an allow-listed, redacted projection with approximate coordinates. Do not reinstate the pending clause — doing so silently re-opens that exposure.",
    "_comment_create_policy": "Creation is admin-only so it can only happen through the createJobPost function. Posting a job now costs a credit or an active subscription, and while this rule allowed a client to create the record directly, that paywall was bypassable by calling the platform's create method — the entitlement check would simply never run. The function performs the check, creates the job, and only then spends the credit.",
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.accepted_by_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.accepted_by_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}