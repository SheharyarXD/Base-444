{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "Homeowner",
        "Realtor",
        "Contractor",
        "Business Owner",
        "Handyman"
      ],
      "title": "User Type"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "realtor_pro",
        "handyman_pro",
        "business_pro"
      ],
      "title": "Plan",
      "default": "free"
    },
    "pending_priority_boost": {
      "type": "boolean",
      "title": "Pending Priority Booking Boost",
      "description": "Set by confirmPurchase after a Priority Booking add-on purchase. Consumed (and cleared) the next time this user creates a Booking, which is stamped is_priority: true.",
      "default": false
    },
    "venmo_username": {
      "type": "string",
      "title": "Venmo Username"
    },
    "paypal_email": {
      "type": "string",
      "title": "PayPal Email"
    },
    "cashapp_cashtag": {
      "type": "string",
      "title": "Cash App $Cashtag"
    }
  },
  "required": [
    "user_type"
  ]
}
